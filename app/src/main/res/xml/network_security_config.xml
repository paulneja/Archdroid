<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything else stays https-only. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- The Arch Linux ARM mirror network is http; os.archlinuxarm.org redirects to
         whichever regional mirror is closest, all under this domain. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">archlinuxarm.org</domain>
    </domain-config>
</network-security-config>
